PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL) — add your real values in .env (never commit .env)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI & Travel APIs (Future Integrations)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# PayToAll API Credentials (Recharge, Travel & Payment Integration)
PAYTOALL_API_KEY=your_paytoall_api_key_here
PAYTOALL_MEMBER_ID=your_paytoall_member_id_here
PAYTOALL_BASE_URL=https://paytoall.in/api/v1

